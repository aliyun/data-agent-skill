{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "音乐零售月度销售报告数据",
  "type": "object",
  "properties": {
    "report_month": {
      "type": "string",
      "description": "报告月份，yyyyMM 字符串（如 202512），与两张落盘明细同月"
    },
    "headline": {
      "type": "string",
      "description": "一句话总览：本月结构性与达成性结论的方向性概括；禁止手写具体销量/达成率数字（数值一律由页面 KPI 卡呈现）"
    },
    "highlights": {
      "type": "array",
      "description": "本月要点，2~4 条",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "一条要点：渠道或达成维度的方向性描述，可点名渠道/曲目名称，禁止手写具体数字"
          }
        },
        "required": ["text"]
      }
    },
    "channel_rows": {
      "type": "array",
      "description": "渠道销量分布（$read 直读 渠道销量分布.csv），按销量降序",
      "items": {
        "type": "object",
        "properties": {
          "channel": {"type": "string", "description": "渠道名：数字单曲 / 数字专辑 / 会员单曲包"},
          "sales_qty": {"type": "number", "description": "当月销量（份）"},
          "sales_amount": {"type": "number", "description": "当月收入（元）"},
          "share_pct": {"type": "number", "description": "销量占比，0~1 小数"}
        },
        "required": ["channel", "sales_qty", "sales_amount", "share_pct"]
      },
      "x-direct-read-allowed": {
        "orient": "records",
        "column_map": {
          "渠道": "channel",
          "销量": "sales_qty",
          "收入": "sales_amount",
          "销量占比": "share_pct"
        }
      }
    },
    "track_rows": {
      "type": "array",
      "description": "曲目达成明细（$read 直读 曲目达成明细.csv），达成率升序",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {"type": "string", "description": "曲目编号，如 T0107"},
          "track_name": {"type": "string", "description": "曲目名称"},
          "sales_qty": {"type": "number", "description": "当月销量（份）"},
          "target_qty": {"type": "number", "description": "当月目标（份）"},
          "achievement": {
            "type": ["number", "string"],
            "description": "达成率（0~2 小数）；目标缺失时为字符串 \"—\""
          },
          "verdict": {"type": "string", "description": "达标 / 未达标 / —（目标缺失）"}
        },
        "required": ["track_id", "track_name", "sales_qty", "target_qty", "achievement", "verdict"]
      },
      "x-direct-read-allowed": {
        "orient": "records",
        "column_map": {
          "曲目编号": "track_id",
          "曲目名称": "track_name",
          "当月销量": "sales_qty",
          "当月目标": "target_qty",
          "达成率": "achievement",
          "判定": "verdict"
        }
      }
    }
  },
  "required": ["report_month", "headline", "highlights", "channel_rows", "track_rows"]
}
