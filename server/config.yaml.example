# Data Agent MCP Server configuration (YAML).
# Location: $DATA_AGENT_CONFIG > ./config.yaml > ~/.data-agent/config.yaml
#           > ~/.data-agent/config.json (legacy)
# Priority: env vars > .env file > this file > defaults.
# Credentials (AK/SK) belong in .env or the credential chain — never here.

region: cn-hangzhou
dms_unit: ""              # empty = auto-resolved via GetActiveRouteUnit
workspace_id: ""          # empty = auto personal workspace
custom_agent_id: ""       # default custom agent; empty = the backend's built-in agent
sessions_dir: ~/.data-agent/sessions
api_key: ""               # API Key auth; leave empty for AK/SK (required for identity mode)

# Endpoint overrides. Each is empty by default and then derived from `region`.
# Set them for VPC-only egress or non-public-cloud deployments; every host the
# server talks to is listed here, so a fully private deployment needs no other
# network change (the OSS upload host comes from the signature response).

# AK/SK-signed Data Agent API (2025-04-14): create/send/status + SSE stream.
# Empty = dms.{region}.aliyuncs.com. Env: DATA_AGENT_ENDPOINT.
data_agent_endpoint: ""

# dms-enterprise (2018-11-01) metadata APIs: database/table/instance discovery,
# import tagging, GetActiveRouteUnit.
# Empty = dms-enterprise.{region}.aliyuncs.com. Env: DATA_AGENT_DMS_ENTERPRISE_ENDPOINT.
dms_enterprise_endpoint: ""

# API Key auth only (ignored with AK/SK): control plane and streaming plane.
# Empty = dataagent-{region}.aliyuncs.com / dataagent-stream-{region}.aliyuncs.com.
# Env: DATA_AGENT_API_KEY_ENDPOINT / DATA_AGENT_API_KEY_STREAM_ENDPOINT.
api_key_endpoint: ""
api_key_stream_endpoint: ""

# STS AssumeRole settings used by identity multi-tenant mode.
sts:
  endpoint: ""            # default: sts.{region}.aliyuncs.com
  session_expiration: 3600

# Confine data_agent_upload_file to these directories. The tool reads a
# server-side path chosen by the caller, so leaving this empty on the HTTP
# transports (streamable-http / sse) disables uploads entirely (fail-closed) —
# otherwise a remote client could read any file the server process can.
# The stdio transport (local caller, same trust domain) stays unrestricted
# while the list is empty. Env override: DATA_AGENT_UPLOAD_DIRS (path list).
upload:
  allowed_dirs: []
  #  - ~/data-agent-uploads
  #  - /srv/data-agent/inbox

# Blocking-wait ceiling for data_agent_wait_result and data_agent_status
# (wait_timeout), in seconds. Requests above the cap are clamped so the tool
# response always beats reverse-proxy and client timeouts (~120s in common
# clients and nginx default proxy_read_timeout 60s) — a graceful reason=timeout with progress info instead of a
# "context canceled" error. Raise it only if every client's tool-call timeout
# is known to be higher. Env override: DATA_AGENT_WAIT_CAP (default 55).

# Logging. Everything goes to stderr: on stdio the host agent captures it, on
# the HTTP transports the supervisor (systemd, container runtime) does.
log:
  # Per-tool-call logging:
  #   basic — tool name, caller identity, outcome, duration
  #   full  — adds arguments with sensitive values redacted; these carry user
  #           questions and table names, so prefer it for troubleshooting
  #           rather than steady-state operation
  #   off   — no per-call logging
  # Empty keeps the transport default: basic for a standalone deployment
  # (streamable-http / sse), off under stdio where the host agent owns the
  # console. The identity token is never logged at any level.
  # Env override: DATA_AGENT_LOG_REQUESTS.
  requests: ""

# Multi-tenant identity mode (generic; legacy section name "aily" still works).
# The upstream caller (Feishu Aily, a gateway, a portal, ...) forwards the
# end-user identity as HTTP headers on every MCP request. The server maps the
# identity to a RAM role, assumes it via STS, and runs all Data Agent calls
# with the per-user temporary credential — RAM access policies and DMS data
# permissions apply per end user.
#
# Two mapping styles (combinable; named groups win over default):
#   1. Global sharing: identity.default — one role (+ workspace/agent/mode
#      defaults) for every identified user.
#   2. Groups: identity.groups.<name> — each group has its own role and
#      defaults, and lists its member users.
identity:
  enabled: false
  # Upstream-signed identity (Feishu Aily "JWT 身份验签"). The platform signs
  # the end-user identity with an HS256 secret shown in its MCP editor and
  # sends it on every request, so the signature identifies the user.
  # A JWT is used whenever the caller sends one; a request without one falls
  # back to the identity headers below. A token that is present but invalid is
  # always rejected, never retried against the headers. auth_token is checked
  # first on both paths (see below) and is required whenever identity is on.
  jwt:
    enabled: false
    secret: ""            # HMAC key, used as-is (no base64). Prefer .env / env IDENTITY_JWT_SECRET
    # secrets lets several upstream agents share this server, each signing with
    # its own key; a token is accepted if any key (secret + these) verifies it.
    # Env override: IDENTITY_JWT_SECRETS (comma-separated).
    secrets: []
    header: ""            # default: x-aily-jwt (bare token, no "Bearer " prefix)
  # Which identity field becomes the STS RoleSessionName segment
  # ("<session_name_prefix>-<value>"), i.e. what ActionTrail records:
  #   user_id (default) | email | enterprise_email | employee_no
  #   | tenant_id | agent_id
  # Group membership is always matched on user_id and email, independent of
  # this setting, so changing it does not affect role mapping.
  session_name_claim: user_id
  # Reject requests without identity headers instead of using the server identity.
  require_identity: true
  # Caller authentication: must equal the token header on every request, so
  # only the trusted upstream platform can act on behalf of users. Configure
  # the same value as a custom header in the upstream MCP registration.
  # Env override: IDENTITY_AUTH_TOKEN (legacy: shared_secret / AILY_SHARED_SECRET).
  auth_token: ""
  # STS RoleSessionName: "<prefix>-<user_id>", what ActionTrail records.
  # Leave the key out to keep the historical "aily-<user_id>"; set it to an
  # empty string to drop the prefix entirely ("<user_id>" alone); or set any
  # other value for "<value>-<user_id>".
  # Env override: IDENTITY_SESSION_NAME_PREFIX (empty value = no prefix).
  #session_name_prefix: ""
  # Identity header names; defaults are Feishu Aily compatible.
  headers:
    user: ""              # default: x-aily-user
    email: ""             # default: x-aily-email
    token: ""             # default: x-aily-token
  # Style 1 — global sharing: catch-all for every identified user.
  # Remove/empty it to reject users that belong to no group (fail-closed).
  default:
    role_arn: ""          # e.g. acs:ram::<account-id>:role/da-default
    workspace_id: ""      # optional session defaults for this group
    custom_agent_id: ""
    mode: ""              # auto | lite | pro | ultra
  # Style 2 — groups: per-group role + defaults + member list.
  groups: {}
  #  analysts:
  #    role_arn: acs:ram::<account-id>:role/da-analysts
  #    workspace_id: ws-analysts
  #    custom_agent_id: ca-xxxx
  #    mode: pro
  #    users: [ou_alice, bob@example.com]   # user id or email; one group per user
