# Data Agent MCP Server configuration (YAML).
# Security-remediation implementation is under validation, NOT release acceptance.
# See README.md and its release checklist before upgrading a deployment.
# Location: $DATA_AGENT_CONFIG > ./config.yaml > ~/.data-agent/config.yaml
#           > ~/.data-agent/config.json (legacy)
# Priority: env vars > .env file > this file > defaults.
# Prefer environment/managed secret injection and the SDK credential chain.
# Actual secret-bearing YAML/JSON/.env files must be process-owned regular files
# with POSIX mode 0600/0400 in trusted directories; public placeholders may be 0644.
# The server does not chmod/chown, migrate files, or authorize deployment changes.

region: cn-hangzhou
dms_unit: ""              # empty = auto-resolved via GetActiveRouteUnit
workspace_id: ""          # empty = auto personal workspace
custom_agent_id: ""       # empty = the backend's built-in agent
sessions_dir: ~/.data-agent/sessions

# Only SDK default credential-chain AK/STS authentication is supported. Legacy
# API Key inputs cause a sanitized migration error even with the gateway off;
# remove old keys/variables rather than leaving empty YAML keys (see README.md).

# Existing Data Agent / DMS overrides default to hosts derived from region.
# Signed API/SSE clients reject redirects; do not change targets to bypass errors.
# The OSS upload host still comes from the upload signature response.
data_agent_endpoint: ""      # default: dms.{region}.aliyuncs.com; DATA_AGENT_ENDPOINT
dms_enterprise_endpoint: ""  # default: dms-enterprise.{region}.aliyuncs.com
                            # env: DATA_AGENT_DMS_ENTERPRISE_ENDPOINT

# 19 tools off / 28 base (9 gateway) / 30 with P2b (11 gateway).
# Prior cloud checks are historical, not post-remediation release evidence.
# Real JWT/platform, differential-role and least-privilege gates remain open.
agent_gateway:
  enabled: false
  # P2b read-only control-plane summaries require enabled=true and operator
  # acceptance of the upstream principal's visibility, not chat-user database ACL.
  # Same-role sessions do not provide independent cloud row/column permissions.
  data_sources_enabled: false
  # Explicit when enabled: public dms.<region>.aliyuncs.com, matching region.
  # Host only: no scheme, port, path, query, userinfo, fragment or VPC endpoint.
  endpoint: dms.cn-hangzhou.aliyuncs.com
  request_timeout_seconds: 30     # outbound HTTP budget, not end-to-end STS time
  max_response_bytes: 4194304     # 4 MiB after decompression, success and errors

sts:
  endpoint: ""                   # default: sts.{region}.aliyuncs.com
  session_expiration: 3600

# Remote ingress only. Omitted numeric settings use defaults; explicit zero or
# negative values are rejected, not interpreted as disabling a safety limit.
# Per-principal/session limits cannot exceed their corresponding totals.
http:
  max_request_bytes: 1048576             # every MCP POST, including notifications
  max_header_bytes: 65536                # Go header parser semantics + fixed slack
  read_header_timeout_seconds: 5
  read_body_timeout_seconds: 10          # body reading only, cleared before dispatch
  idle_timeout_seconds: 60               # idle keep-alive, not an active stream
  max_sessions: 4096                    # process total, including init reservations
  max_sessions_per_principal: 64
  max_inflight_requests: 256            # accepted dispatch until actually finished
  max_inflight_per_session: 8           # SSE 202 does not release a running task
  session_idle_timeout_seconds: 1800    # HTTP: no connection and no in-flight calls
  max_stream_lifetime_seconds: 3600     # JWT exp may end a stream sooner; reconnect

# Blocking waits retain DATA_AGENT_WAIT_CAP (default 55 seconds). Configure proxy
# and client timeouts above it; do not apply a short timeout to the whole stream.
log:
  # basic: tool, verified caller, outcome, duration; full adds redacted arguments
  # for OLD tools (may include business questions); use only for diagnostics.
  # off: no per-call logging. Empty: basic remotely, off under stdio.
  # Logs go to stderr, with single-line escaping and output budgets. Gateway full
  # still excludes parameters, returned data and raw errors; never log credentials.
  # Env: DATA_AGENT_LOG_REQUESTS.
  requests: ""
  # Periodic performance sampler: host (Linux /proc), process, Go runtime
  # (goroutines, heap, GC, scheduler latency), tool-call counters, protocol
  # sessions and tenant/watcher counts, one JSON object per line. Contains no
  # arguments, identities or credentials. Rotates once to <file>.1.
  # Env: DATA_AGENT_PERF_LOG, DATA_AGENT_PERF_LOG_FILE, DATA_AGENT_PERF_LOG_INTERVAL.
  perf:
    enabled: false
    file: ~/.data-agent/perf.log
    interval_seconds: 30
    max_bytes: 67108864

# This template defaults to LOCAL STDIO ONLY. All HTTP/SSE deployments, gateway
# on OR off, must explicitly set enabled=true, require_identity=true, a nonempty
# auth_token via environment, and a valid namespace. No anonymous/global fallback
# for any remote tool or protocol method; no weak-compatibility switch.
# Every initialize/tools/list/call/notification and GET/POST/DELETE authenticates.
# Protocol IDs are server-issued, principal-owned and leased (see README.md).
identity:
  enabled: false
  require_identity: true
  # Required remotely: stable administrator-chosen non-secret trust domain,
  # 1-64 chars [a-z0-9][a-z0-9_-]*. Never derive it from a request or RAM role.
  namespace: ""
  # Cached Tenants + in-progress initialization reservations, NOT connections.
  # No automatic eviction; closing a protocol session does not free a Tenant.
  max_tenants: 128
  auth_token: ""                 # inject IDENTITY_AUTH_TOKEN; trusted platform only
  jwt:
    enabled: false              # explicit trusted-header mode; not JWT fallback
    # When true, ALL remote requests need a valid HS256 JWT with exp, nonempty
    # tenant_id + agent_id, and user_id or email. Missing/invalid JWT is rejected.
    secret: ""                  # inject IDENTITY_JWT_SECRET; HMAC key used as-is
    # All keys have equivalent signing authority within ONE trusted domain.
    # Use for rotation/mutually trusted apps, never unrelated organizations.
    # Independent trust domains need separate instances/config/storage roots.
    secrets: []                 # env: IDENTITY_JWT_SECRETS (comma-separated)
    header: ""                  # default x-aily-jwt; bare token, no Bearer prefix
  # RoleSessionName attribution only; mapping always uses scoped user_id/email.
  # user_id | email | enterprise_email | employee_no | tenant_id | agent_id
  session_name_claim: user_id
  # Omit prefix for historical "aily-<value>"; empty string means bare value.
  # Env: IDENTITY_SESSION_NAME_PREFIX (empty is meaningful).
  #session_name_prefix: ""
  # Header mode: trusted proxy must overwrite client identity headers, keep the
  # platform token from end users, and guarantee unique IDs within namespace.
  headers:
    user: ""                    # default x-aily-user
    email: ""                   # default x-aily-email
    token: ""                   # default x-aily-token
  # No default mapping: unmatched identities are rejected. To add a default,
  # configure a real role and exact JWT tenant/agent scope (empty in header mode).
  # Named groups win ONLY within the exact scope; multiple group matches reject,
  # even if they have the same role. No wildcard or cross-scope default.
  #default:
  #  tenant_id: "<trusted-tenant-id>"  # JWT only; use "" in header mode
  #  agent_id: "<trusted-agent-id>"    # JWT only; use "" in header mode
  #  role_arn: "acs:ram::<account-id>:role/<default-role>"
  #  workspace_id: ""
  #  custom_agent_id: ""
  #  mode: lite
  groups: {}
  #  analysts:
  #    tenant_id: "<trusted-tenant-id>" # JWT only; use "" in header mode
  #    agent_id: "<trusted-agent-id>"   # JWT only; use "" in header mode
  #    role_arn: "acs:ram::<account-id>:role/<analyst-role>"
  #    workspace_id: "<workspace-id>"
  #    custom_agent_id: ""
  #    mode: pro
  #    users: ["<user-id>", "<user-email>"]

# Remote local history: sessions_dir/identity-v2/<principal_id>/ with owner.json.
# Principal hashes namespace, auth mode, tenant/agent and typed user_id/email.
# No automatic old identity/<sanitized-key> fallback, claiming or migration.
# Historical import requires separately authorized admin ownership verification.
# Owner markers/local isolation do not establish cloud session ACL or row isolation.
# stdio uses one confined local process root, never per-chat-user authorization.
