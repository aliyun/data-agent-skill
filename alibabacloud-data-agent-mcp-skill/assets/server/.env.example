# Data Agent MCP Server .env
# Loaded at startup from $DATA_AGENT_ENV_FILE, then ./.env (does not override
# variables already set in the environment). Keep secrets here — never in
# config.yaml.

# Long-term AK/SK. In aily multi-tenant mode this RAM user needs
# sts:AssumeRole permission on all mapped roles.
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# Optional overrides (highest priority, above config.yaml).
#DATA_AGENT_REGION=cn-hangzhou
#DATA_AGENT_DMS_UNIT=
#DATA_AGENT_DMS_ENTERPRISE_ENDPOINT=
#DATA_AGENT_WORKSPACE_ID=
#DATA_AGENT_SESSIONS_DIR=
#DATA_AGENT_API_KEY=
#DATA_AGENT_CONFIG=./config.yaml

# Shared secret for aily request legitimacy check (see aily.shared_secret).
#AILY_SHARED_SECRET=
