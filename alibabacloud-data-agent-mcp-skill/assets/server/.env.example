# Data Agent MCP Server .env
# Loaded at startup from $DATA_AGENT_ENV_FILE, then ./.env (does not override
# variables already set in the environment). Keep secrets here — never in
# config.yaml.

# Long-term AK/SK. In identity multi-tenant mode this RAM user needs
# sts:AssumeRole permission on all mapped roles.
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# Optional overrides (highest priority, above config.yaml).
#DATA_AGENT_REGION=cn-hangzhou
#DATA_AGENT_DMS_UNIT=
#DATA_AGENT_DMS_ENTERPRISE_ENDPOINT=
#DATA_AGENT_ENDPOINT=
#DATA_AGENT_API_KEY_ENDPOINT=
#DATA_AGENT_API_KEY_STREAM_ENDPOINT=
#DATA_AGENT_WORKSPACE_ID=
#DATA_AGENT_CUSTOM_AGENT_ID=
#DATA_AGENT_SESSIONS_DIR=
#DATA_AGENT_API_KEY=
#DATA_AGENT_CONFIG=./config.yaml

# Directories data_agent_upload_file may read (overrides upload.allowed_dirs).
# Colon-separated. Required on the HTTP transports, which refuse uploads while
# no directory is allowed.
#DATA_AGENT_UPLOAD_DIRS=/srv/data-agent/inbox

# Caller authentication token for identity mode (see identity.auth_token).
# Required whenever identity mode is on: it is checked first on both the JWT
# and header paths. IDENTITY_AUTH_TOKEN is the current name; AILY_SHARED_SECRET
# and IDENTITY_SHARED_SECRET remain accepted as legacy aliases.
#IDENTITY_AUTH_TOKEN=

# HS256 secret for upstream-signed identity (see identity.jwt.secret). Shown in
# the Feishu Aily MCP editor; used as the HMAC key as-is, no base64 decoding.
#IDENTITY_JWT_SECRET=

# Additional HS256 secrets when several upstream agents each sign with their own
# key (see identity.jwt.secrets). Comma-separated; a token is accepted if any of
# IDENTITY_JWT_SECRET plus these verifies it.
#IDENTITY_JWT_SECRETS=
